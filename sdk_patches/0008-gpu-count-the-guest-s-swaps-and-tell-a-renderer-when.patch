From f883dc0c3860891f130d7c9b50b0f60832fe9fe0 Mon Sep 17 00:00:00 2001
From: Gustavo Garcia <44309076+ElGuslml@users.noreply.github.com>
Date: Tue, 20 Oct 2026 13:53:23 -0600
Subject: [PATCH] gpu: count the guest's swaps, and tell a renderer when one
 executes

VdSwap writes a PM4_XE_SWAP into the ring buffer for every frame the guest
presents, and the command processor executes it in its turn, after what
the guest submitted before it and paced by the guest's own waits for the
vertical blank. The host presenters show a frame at that point. A renderer
that presents the guest's frames itself when the guest calls its present
function (NativeXRenderer) shows them earlier, as the guest's CPU produces
them: the CPU runs a frame ahead of the command processor, and its delays
reach the screen. Kameo's Bink code waits a vertical blank for the GPU now
and then while locking a video texture; its swaps still execute every
16.7 ms, but its present calls come 30 ms apart.

IGraphicsSystem gains:
- NoteSwapIssued(), called by VdSwap after it wrote the swap packet;
- GetSwapCounts(issued, executed), safe from any thread;
- SetSwapObserver(observer, user): called on the GPU thread after every
  executed swap, with the number executed so far.

A renderer tags each frame with the issued count when the guest presents
it, and shows the frame once the executed count reaches the tag.
kGpuPluginAbiVersion is bumped for the new virtual functions. With no
observer set the cost is one atomic increment per swap.

This patch is only for projects that use NativeXRenderer; it is kept in
native_x_renderer/sdk_patches/ and applied after the shared series.
---
 include/rex/graphics/command_processor.h | 10 +++++++++
 include/rex/graphics/graphics_system.h   |  5 +++++
 include/rex/system/gpu_plugin.h          |  2 +-
 include/rex/system/interfaces/graphics.h | 26 ++++++++++++++++++++++++
 src/graphics/command_processor.cpp       |  4 ++++
 src/graphics/graphics_system.cpp         | 15 ++++++++++++++
 src/kernel/xboxkrnl/xboxkrnl_video.cpp   |  4 ++++
 7 files changed, 65 insertions(+), 1 deletion(-)

diff --git a/include/rex/graphics/command_processor.h b/include/rex/graphics/command_processor.h
index 1d2e773..a75e370 100644
--- a/include/rex/graphics/command_processor.h
+++ b/include/rex/graphics/command_processor.h
@@ -101,6 +101,12 @@ class CommandProcessor {
     signal_gate_user_ = user;
     signal_gate_.store(gate, std::memory_order_release);
   }
+  // See system::IGraphicsSystem::SetSwapObserver and GetSwapCounts.
+  void SetSwapObserver(system::GpuSwapObserver observer, void* user) {
+    swap_observer_user_ = user;
+    swap_observer_.store(observer, std::memory_order_release);
+  }
+  uint64_t swaps_executed() const { return swaps_executed_.load(std::memory_order_acquire); }
 
   // See system::IGraphicsSystem::SetOcclusionQueryResolver.
   void SetOcclusionQueryResolver(system::OcclusionQueryResolver resolver, void* user) {
@@ -300,6 +306,10 @@ class CommandProcessor {
   }
   std::atomic<system::GpuSignalGate> signal_gate_{nullptr};
   void* signal_gate_user_ = nullptr;
+  // The guest's swaps executed (PM4_XE_SWAP), and who is told of each (SetSwapObserver).
+  std::atomic<uint64_t> swaps_executed_{0};
+  std::atomic<system::GpuSwapObserver> swap_observer_{nullptr};
+  void* swap_observer_user_ = nullptr;
 
   // Answers occlusion queries the command processor has no host query for (SetOcclusionQueryResolver).
   std::atomic<system::OcclusionQueryResolver> occlusion_query_resolver_{nullptr};
diff --git a/include/rex/graphics/graphics_system.h b/include/rex/graphics/graphics_system.h
index 9900985..d7e82ca 100644
--- a/include/rex/graphics/graphics_system.h
+++ b/include/rex/graphics/graphics_system.h
@@ -79,6 +79,9 @@ class GraphicsSystem : public system::IGraphicsSystem {
   bool SetHostRendering(bool enabled) override;
   bool SetOcclusionQueryResolver(system::OcclusionQueryResolver resolver, void* user) override;
   bool SetSignalGate(system::GpuSignalGate gate, void* user) override;
+  void NoteSwapIssued() override { swaps_issued_.fetch_add(1, std::memory_order_acq_rel); }
+  bool GetSwapCounts(uint64_t& issued, uint64_t& executed) override;
+  bool SetSwapObserver(system::GpuSwapObserver observer, void* user) override;
   bool GetGammaRamp(system::GammaRamp& ramp) override;
   void DispatchInterruptCallback(uint32_t source, uint32_t cpu);
 
@@ -135,6 +138,8 @@ class GraphicsSystem : public system::IGraphicsSystem {
   std::unique_ptr<::rex::ui::Presenter> presenter_;
 
   std::atomic_flag host_gpu_loss_reported_;
+  // The guest's swaps issued by VdSwap (NoteSwapIssued).
+  std::atomic<uint64_t> swaps_issued_{0};
 };
 
 }  // namespace rex::graphics
diff --git a/include/rex/system/gpu_plugin.h b/include/rex/system/gpu_plugin.h
index 30fd428..7220d1d 100644
--- a/include/rex/system/gpu_plugin.h
+++ b/include/rex/system/gpu_plugin.h
@@ -29,7 +29,7 @@
 namespace rex::system {
 
 // Bump on any change to GpuCreateInfo or to the IGraphicsSystem interface.
-inline constexpr uint32_t kGpuPluginAbiVersion = 4;
+inline constexpr uint32_t kGpuPluginAbiVersion = 5;
 
 inline constexpr const char* kGpuCreateSymbol = "rex_gpu_create";
 inline constexpr const char* kGpuAbiVersionSymbol = "rex_gpu_abi_version";
diff --git a/include/rex/system/interfaces/graphics.h b/include/rex/system/interfaces/graphics.h
index f24f617..78595d1 100644
--- a/include/rex/system/interfaces/graphics.h
+++ b/include/rex/system/interfaces/graphics.h
@@ -61,6 +61,10 @@ using OcclusionQueryResolver = bool (*)(void* user, uint32_t sample_count_addres
 // Passed by the command processor before it signals the guest (see IGraphicsSystem::SetSignalGate).
 using GpuSignalGate = void (*)(void* user);
 
+// Called by the command processor after it executed one of the guest's swaps, with the number executed so far
+// (see IGraphicsSystem::SetSwapObserver).
+using GpuSwapObserver = void (*)(void* user, uint64_t swaps_executed);
+
 // The guest's display gamma ramp, as the GPU's display controller holds it (the DC_LUT registers) and the
 // command processor tracks it (see IGraphicsSystem::GetGammaRamp).
 struct GammaRamp {
@@ -156,6 +160,28 @@ class IGraphicsSystem {
     return false;
   }
 
+  // The guest's swaps: VdSwap writes one into the ring buffer for every frame the guest presents, and the
+  // command processor executes it in its turn, after what the guest submitted before it and at the pace the
+  // guest's frames are shown (the guest's own waits for the vertical blank come first in the ring buffer). A
+  // renderer that presents the guest's frames itself, when the guest calls its present function, can show
+  // each one when its swap executes instead, as the host presenters do: the guest's CPU runs ahead of the
+  // command processor, and its delays then do not reach the screen.
+  // NoteSwapIssued: called by VdSwap after it wrote a swap into the ring buffer.
+  virtual void NoteSwapIssued() {}
+  // The swaps issued (VdSwap calls) and executed so far. Safe from any thread. Returns false if the system has
+  // no command processor.
+  virtual bool GetSwapCounts(uint64_t& issued, uint64_t& executed) {
+    issued = executed = 0;
+    return false;
+  }
+  // Called on the GPU thread after every swap the command processor executes. nullptr turns it off. Returns
+  // false if the system has no command processor.
+  virtual bool SetSwapObserver(GpuSwapObserver observer, void* user) {
+    (void)observer;
+    (void)user;
+    return false;
+  }
+
   // The guest's current display gamma ramp, for a renderer that presents the guest's frames itself. The
   // host presenters apply it to the front buffer; such a renderer has to as well. Safe from any thread.
   // Returns false if the system has no command processor.
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index 0ca453c..06ca30b 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -1026,6 +1026,10 @@ bool CommandProcessor::ExecutePacketType3_XE_SWAP(memory::RingBuffer* reader, ui
   reader->AdvanceRead((count - 4) * sizeof(uint32_t));
 
   IssueSwap(frontbuffer_ptr, frontbuffer_width, frontbuffer_height);
+  uint64_t swaps_executed = swaps_executed_.fetch_add(1, std::memory_order_acq_rel) + 1;
+  if (auto observer = swap_observer_.load(std::memory_order_acquire)) {
+    observer(swap_observer_user_, swaps_executed);
+  }
 
   // gpu_guest_fps_limit: hold the command processor after a guest
   // frame so the next one isn't swapped before 1/limit s has passed. The game's
diff --git a/src/graphics/graphics_system.cpp b/src/graphics/graphics_system.cpp
index 8bf57bf..4243e15 100644
--- a/src/graphics/graphics_system.cpp
+++ b/src/graphics/graphics_system.cpp
@@ -330,6 +330,21 @@ bool GraphicsSystem::SetSignalGate(system::GpuSignalGate gate, void* user) {
   return true;
 }
 
+bool GraphicsSystem::GetSwapCounts(uint64_t& issued, uint64_t& executed) {
+  issued = swaps_issued_.load(std::memory_order_acquire);
+  executed = command_processor_ ? command_processor_->swaps_executed() : 0;
+  return command_processor_ != nullptr;
+}
+
+bool GraphicsSystem::SetSwapObserver(system::GpuSwapObserver observer, void* user) {
+  if (!command_processor_) {
+    return false;
+  }
+  command_processor_->SetSwapObserver(observer, user);
+  REXGPU_INFO("Swap observer {}", observer ? "set" : "removed");
+  return true;
+}
+
 bool GraphicsSystem::GetGammaRamp(system::GammaRamp& ramp) {
   if (!command_processor_) {
     return false;
diff --git a/src/kernel/xboxkrnl/xboxkrnl_video.cpp b/src/kernel/xboxkrnl/xboxkrnl_video.cpp
index 1254710..cf558b7 100644
--- a/src/kernel/xboxkrnl/xboxkrnl_video.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_video.cpp
@@ -518,6 +518,10 @@ void VdSwap_entry(mapped_void buffer_ptr,      // ptr into primary ringbuffer
   for (uint32_t i = offset; i < 64; i++) {
     dwords[i] = xenos::MakePacketType2();
   }
+
+  if (auto* graphics_system = REX_KERNEL_STATE()->emulator()->graphics_system()) {
+    graphics_system->NoteSwapIssued();
+  }
 }
 
 void RegisterVideoExports(rex::runtime::ExportResolver* export_resolver,
