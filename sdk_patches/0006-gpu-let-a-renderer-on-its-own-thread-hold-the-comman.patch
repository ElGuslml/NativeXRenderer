From a7ec60320114c7b3bbca08ecbf4f1cd9b51282ff Mon Sep 17 00:00:00 2001
From: Gustavo Garcia <44309076+ElGuslml@users.noreply.github.com>
Date: Sat, 17 Oct 2026 03:53:13 -0600
Subject: [PATCH 6/6] gpu: let a renderer on its own thread hold the command
 processor's signals

A renderer that draws the guest's frames itself (NativeXRenderer) can do its
work on a thread of its own instead of inside the guest's Direct3D calls. It
then reads vertex buffers, index buffers and textures from guest memory later
than the guest submitted them, and the guest must not reuse that memory
before the renderer is done with it. The guest learns that it may only from
the GPU: fences written into memory, interrupts, swaps.

SetSignalGate registers a callback that the command processor calls on the
GPU thread before every such signal: the packets that write guest memory
(EVENT_WRITE_SHD fences, MEM_WRITE, COND_WRITE, REG_TO_MEM, EVENT_WRITE_EXT
and EVENT_WRITE_ZPD), the scratch register and read pointer write-backs, and
the interrupts (INTERRUPT, XE_SWAP). The renderer waits there until it has
consumed what the guest submitted so far, so the guest never sees the GPU
further along than the renderer. The command processor holds no lock while
it waits. Off (nullptr) by default, and one atomic load per signal when off.

kGpuPluginAbiVersion is bumped for the new virtual function.

This patch is only for projects that use NativeXRenderer; it is kept in
native_x_renderer/sdk_patches/ and applied after the shared series.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/rex/graphics/command_processor.h | 15 +++++++++++++++
 include/rex/graphics/graphics_system.h   |  1 +
 include/rex/system/gpu_plugin.h          |  2 +-
 include/rex/system/interfaces/graphics.h | 16 ++++++++++++++++
 src/graphics/command_processor.cpp       | 10 ++++++++++
 src/graphics/graphics_system.cpp         |  9 +++++++++
 6 files changed, 52 insertions(+), 1 deletion(-)

diff --git a/include/rex/graphics/command_processor.h b/include/rex/graphics/command_processor.h
index a788e79..1d2e773 100644
--- a/include/rex/graphics/command_processor.h
+++ b/include/rex/graphics/command_processor.h
@@ -96,6 +96,12 @@ class CommandProcessor {
 
   // See system::IGraphicsSystem::SetHostRendering.
   void SetHostRendering(bool enabled) { host_rendering_.store(enabled, std::memory_order_relaxed); }
+  // See system::IGraphicsSystem::SetSignalGate.
+  void SetSignalGate(system::GpuSignalGate gate, void* user) {
+    signal_gate_user_ = user;
+    signal_gate_.store(gate, std::memory_order_release);
+  }
+
   // See system::IGraphicsSystem::SetOcclusionQueryResolver.
   void SetOcclusionQueryResolver(system::OcclusionQueryResolver resolver, void* user) {
     occlusion_query_resolver_user_ = user;
@@ -286,6 +292,15 @@ class CommandProcessor {
   std::atomic<system::GpuDrawObserver> draw_observer_{nullptr};
   // Off: packets run for synchronization only (SetHostRendering).
   std::atomic<bool> host_rendering_{true};
+  // Passed before every signal to the guest (SetSignalGate).
+  void PassSignalGate() {
+    if (auto gate = signal_gate_.load(std::memory_order_acquire)) {
+      gate(signal_gate_user_);
+    }
+  }
+  std::atomic<system::GpuSignalGate> signal_gate_{nullptr};
+  void* signal_gate_user_ = nullptr;
+
   // Answers occlusion queries the command processor has no host query for (SetOcclusionQueryResolver).
   std::atomic<system::OcclusionQueryResolver> occlusion_query_resolver_{nullptr};
   void* occlusion_query_resolver_user_ = nullptr;
diff --git a/include/rex/graphics/graphics_system.h b/include/rex/graphics/graphics_system.h
index 5ca6713..9900985 100644
--- a/include/rex/graphics/graphics_system.h
+++ b/include/rex/graphics/graphics_system.h
@@ -78,6 +78,7 @@ class GraphicsSystem : public system::IGraphicsSystem {
   bool SetDrawObserver(system::GpuDrawObserver observer, void* user) override;
   bool SetHostRendering(bool enabled) override;
   bool SetOcclusionQueryResolver(system::OcclusionQueryResolver resolver, void* user) override;
+  bool SetSignalGate(system::GpuSignalGate gate, void* user) override;
   bool GetGammaRamp(system::GammaRamp& ramp) override;
   void DispatchInterruptCallback(uint32_t source, uint32_t cpu);
 
diff --git a/include/rex/system/gpu_plugin.h b/include/rex/system/gpu_plugin.h
index 981e32f..30fd428 100644
--- a/include/rex/system/gpu_plugin.h
+++ b/include/rex/system/gpu_plugin.h
@@ -29,7 +29,7 @@
 namespace rex::system {
 
 // Bump on any change to GpuCreateInfo or to the IGraphicsSystem interface.
-inline constexpr uint32_t kGpuPluginAbiVersion = 3;
+inline constexpr uint32_t kGpuPluginAbiVersion = 4;
 
 inline constexpr const char* kGpuCreateSymbol = "rex_gpu_create";
 inline constexpr const char* kGpuAbiVersionSymbol = "rex_gpu_abi_version";
diff --git a/include/rex/system/interfaces/graphics.h b/include/rex/system/interfaces/graphics.h
index 83d7191..f24f617 100644
--- a/include/rex/system/interfaces/graphics.h
+++ b/include/rex/system/interfaces/graphics.h
@@ -58,6 +58,9 @@ using GpuDrawObserver = void (*)(void* user, const GpuDrawInfo& info);
 // number of samples that passed, at the guest's resolution, or false for the fake sample count.
 using OcclusionQueryResolver = bool (*)(void* user, uint32_t sample_count_address, uint64_t* samples);
 
+// Passed by the command processor before it signals the guest (see IGraphicsSystem::SetSignalGate).
+using GpuSignalGate = void (*)(void* user);
+
 // The guest's display gamma ramp, as the GPU's display controller holds it (the DC_LUT registers) and the
 // command processor tracks it (see IGraphicsSystem::GetGammaRamp).
 struct GammaRamp {
@@ -140,6 +143,19 @@ class IGraphicsSystem {
     return false;
   }
 
+  // Called on the GPU thread before the command processor does anything the guest can see as the GPU's
+  // progress: a write to guest memory (EVENT_WRITE_SHD fences, MEM_WRITE, COND_WRITE, REG_TO_MEM,
+  // EVENT_WRITE_EXT and _ZPD, scratch register and read pointer write-backs) or an interrupt (INTERRUPT,
+  // XE_SWAP). A renderer that draws the guest's frames on a thread of its own, from guest memory, waits
+  // there until it has consumed what the guest submitted so far: the guest then never sees the GPU further
+  // along than that renderer, and does not reuse memory it still reads. nullptr turns it off. Returns false
+  // if the system has no command processor.
+  virtual bool SetSignalGate(GpuSignalGate gate, void* user) {
+    (void)gate;
+    (void)user;
+    return false;
+  }
+
   // The guest's current display gamma ramp, for a renderer that presents the guest's frames itself. The
   // host presenters apply it to the front buffer; such a renderer has to as well. Safe from any thread.
   // Returns false if the system has no command processor.
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index 9d4cc85..38cb397 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -259,6 +259,7 @@ void CommandProcessor::WorkerThreadMain() {
     // TODO(benvanik): use reader->Read_update_freq_ and only issue after moving
     //     that many indices.
     if (read_ptr_writeback_ptr_) {
+      PassSignalGate();
       memory::store_and_swap<uint32_t>(memory_->TranslatePhysical(read_ptr_writeback_ptr_),
                                        read_ptr_index_);
     }
@@ -385,6 +386,7 @@ void CommandProcessor::WriteRegister(uint32_t index, uint32_t value) {
     uint32_t scratch_reg = index - XE_GPU_REG_SCRATCH_REG0;
     if ((1 << scratch_reg) & regs.values[XE_GPU_REG_SCRATCH_UMSK]) {
       // Enabled - write to address.
+      PassSignalGate();
       uint32_t scratch_addr = regs.values[XE_GPU_REG_SCRATCH_ADDR];
       uint32_t mem_addr = scratch_addr + (scratch_reg * 4);
       memory::store_and_swap<uint32_t>(memory_->TranslatePhysical(mem_addr), value);
@@ -818,9 +820,11 @@ bool CommandProcessor::ExecutePacketType3(memory::RingBuffer* reader, uint32_t p
       result = ExecutePacketType3_NOP(reader, packet, count);
       break;
     case PM4_INTERRUPT:
+      PassSignalGate();
       result = ExecutePacketType3_INTERRUPT(reader, packet, count);
       break;
     case PM4_XE_SWAP:
+      PassSignalGate();
       result = ExecutePacketType3_XE_SWAP(reader, packet, count);
       break;
     case PM4_INDIRECT_BUFFER:
@@ -834,24 +838,30 @@ bool CommandProcessor::ExecutePacketType3(memory::RingBuffer* reader, uint32_t p
       result = ExecutePacketType3_REG_RMW(reader, packet, count);
       break;
     case PM4_REG_TO_MEM:
+      PassSignalGate();
       result = ExecutePacketType3_REG_TO_MEM(reader, packet, count);
       break;
     case PM4_MEM_WRITE:
+      PassSignalGate();
       result = ExecutePacketType3_MEM_WRITE(reader, packet, count);
       break;
     case PM4_COND_WRITE:
+      PassSignalGate();
       result = ExecutePacketType3_COND_WRITE(reader, packet, count);
       break;
     case PM4_EVENT_WRITE:
       result = ExecutePacketType3_EVENT_WRITE(reader, packet, count);
       break;
     case PM4_EVENT_WRITE_SHD:
+      PassSignalGate();
       result = ExecutePacketType3_EVENT_WRITE_SHD(reader, packet, count);
       break;
     case PM4_EVENT_WRITE_EXT:
+      PassSignalGate();
       result = ExecutePacketType3_EVENT_WRITE_EXT(reader, packet, count);
       break;
     case PM4_EVENT_WRITE_ZPD:
+      PassSignalGate();
       result = ExecutePacketType3_EVENT_WRITE_ZPD(reader, packet, count);
       break;
     case PM4_DRAW_INDX:
diff --git a/src/graphics/graphics_system.cpp b/src/graphics/graphics_system.cpp
index d2ee77a..8bf57bf 100644
--- a/src/graphics/graphics_system.cpp
+++ b/src/graphics/graphics_system.cpp
@@ -321,6 +321,15 @@ bool GraphicsSystem::SetOcclusionQueryResolver(system::OcclusionQueryResolver re
   return true;
 }
 
+bool GraphicsSystem::SetSignalGate(system::GpuSignalGate gate, void* user) {
+  if (!command_processor_) {
+    return false;
+  }
+  command_processor_->SetSignalGate(gate, user);
+  REXGPU_INFO("Signal gate {}", gate ? "set" : "removed");
+  return true;
+}
+
 bool GraphicsSystem::GetGammaRamp(system::GammaRamp& ramp) {
   if (!command_processor_) {
     return false;
