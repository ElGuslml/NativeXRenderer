From fc3d9a3bb985eedbebfc500de46404ffa654acd3 Mon Sep 17 00:00:00 2001
From: Gustavo Garcia <44309076+ElGuslml@users.noreply.github.com>
Date: Wed, 14 Oct 2026 08:32:24 -0600
Subject: [PATCH 4/5] gpu: let a renderer that presents itself read the guest's
 gamma ramp

A renderer that draws and presents the guest's frames itself (sync-only
command processor, NativeXRenderer) has to apply the display gamma ramp the
host presenters apply: the 256-entry table for 8-bit front buffers and the
piecewise linear ramp for 10-bit ones. The command processor tracks both
from the DC_LUT register writes, on its own thread.

IGraphicsSystem::GetGammaRamp copies both ramps with a version that
changes on every write. A mutex taken only where the DC_LUT writes change
an entry guards them against the reader's thread.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/rex/graphics/command_processor.h |  5 +++++
 include/rex/graphics/graphics_system.h   |  1 +
 include/rex/system/interfaces/graphics.h | 21 +++++++++++++++++++++
 src/graphics/command_processor.cpp       | 19 +++++++++++++++++++
 src/graphics/graphics_system.cpp         |  8 ++++++++
 5 files changed, 54 insertions(+)

diff --git a/include/rex/graphics/command_processor.h b/include/rex/graphics/command_processor.h
index e8e1325..a788e79 100644
--- a/include/rex/graphics/command_processor.h
+++ b/include/rex/graphics/command_processor.h
@@ -101,6 +101,8 @@ class CommandProcessor {
     occlusion_query_resolver_user_ = user;
     occlusion_query_resolver_.store(resolver, std::memory_order_release);
   }
+  // See system::IGraphicsSystem::GetGammaRamp. From any thread.
+  void GetGammaRamp(system::GammaRamp& ramp);
   bool host_rendering() const { return host_rendering_.load(std::memory_order_relaxed); }
 
   virtual bool Initialize();
@@ -305,6 +307,9 @@ class CommandProcessor {
   reg::DC_LUT_30_COLOR gamma_ramp_256_entry_table_[256] = {};
   reg::DC_LUT_PWL_DATA gamma_ramp_pwl_rgb_[128][3] = {};
   uint32_t gamma_ramp_rw_component_ = 0;
+  // Guards the two ramps' entries against GetGammaRamp on other threads; the version counts the writes.
+  std::mutex gamma_ramp_mutex_;
+  uint64_t gamma_ramp_version_ = 0;
 };
 
 }  // namespace rex::graphics
diff --git a/include/rex/graphics/graphics_system.h b/include/rex/graphics/graphics_system.h
index 3b11d42..5ca6713 100644
--- a/include/rex/graphics/graphics_system.h
+++ b/include/rex/graphics/graphics_system.h
@@ -78,6 +78,7 @@ class GraphicsSystem : public system::IGraphicsSystem {
   bool SetDrawObserver(system::GpuDrawObserver observer, void* user) override;
   bool SetHostRendering(bool enabled) override;
   bool SetOcclusionQueryResolver(system::OcclusionQueryResolver resolver, void* user) override;
+  bool GetGammaRamp(system::GammaRamp& ramp) override;
   void DispatchInterruptCallback(uint32_t source, uint32_t cpu);
 
   virtual void ClearCaches();
diff --git a/include/rex/system/interfaces/graphics.h b/include/rex/system/interfaces/graphics.h
index 0583505..83d7191 100644
--- a/include/rex/system/interfaces/graphics.h
+++ b/include/rex/system/interfaces/graphics.h
@@ -58,6 +58,19 @@ using GpuDrawObserver = void (*)(void* user, const GpuDrawInfo& info);
 // number of samples that passed, at the guest's resolution, or false for the fake sample count.
 using OcclusionQueryResolver = bool (*)(void* user, uint32_t sample_count_address, uint64_t* samples);
 
+// The guest's display gamma ramp, as the GPU's display controller holds it (the DC_LUT registers) and the
+// command processor tracks it (see IGraphicsSystem::GetGammaRamp).
+struct GammaRamp {
+  // The 256-entry table (DC_LUT_30_COLOR): 10 bits per channel, blue in bits 0:9, green in 10:19, red in
+  // 20:29. Used for 8-bit front buffers.
+  uint32_t table[256];
+  // The piecewise linear ramp (DC_LUT_PWL_DATA), 128 entries of red, green and blue: base in bits 0:15,
+  // delta in bits 16:31. Used for 10-bit front buffers.
+  uint32_t pwl[128][3];
+  // Changes whenever the guest writes either of them.
+  uint64_t version;
+};
+
 class IGraphicsSystem {
  public:
   virtual ~IGraphicsSystem() = default;
@@ -127,6 +140,14 @@ class IGraphicsSystem {
     return false;
   }
 
+  // The guest's current display gamma ramp, for a renderer that presents the guest's frames itself. The
+  // host presenters apply it to the front buffer; such a renderer has to as well. Safe from any thread.
+  // Returns false if the system has no command processor.
+  virtual bool GetGammaRamp(GammaRamp& ramp) {
+    (void)ramp;
+    return false;
+  }
+
   // Persistent shader/pipeline storage under the cache root. Default: none.
   virtual void InitializeShaderStorage(const std::filesystem::path& cache_root, uint32_t title_id,
                                        bool blocking) {
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index a739f53..9d4cc85 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -117,6 +117,19 @@ CommandProcessor::CommandProcessor(GraphicsSystem* graphics_system,
 
 CommandProcessor::~CommandProcessor() = default;
 
+void CommandProcessor::GetGammaRamp(system::GammaRamp& ramp) {
+  std::lock_guard<std::mutex> gamma_ramp_lock(gamma_ramp_mutex_);
+  for (uint32_t i = 0; i < 256; ++i) {
+    ramp.table[i] = gamma_ramp_256_entry_table_[i].value;
+  }
+  for (uint32_t i = 0; i < 128; ++i) {
+    for (uint32_t j = 0; j < 3; ++j) {
+      ramp.pwl[i][j] = gamma_ramp_pwl_rgb_[i][j].value;
+    }
+  }
+  ramp.version = gamma_ramp_version_;
+}
+
 bool CommandProcessor::Initialize() {
   // Initialize the gamma ramps to their default (linear) values - taken from
   // what games set when starting with the sRGB (return value 1)
@@ -400,6 +413,8 @@ void CommandProcessor::WriteRegister(uint32_t index, uint32_t value) {
         bool write_gamma_ramp_component = (regs[XE_GPU_REG_DC_LUT_WRITE_EN_MASK] &
                                            (UINT32_C(1) << (2 - gamma_ramp_rw_component_))) != 0;
         if (write_gamma_ramp_component) {
+          std::lock_guard<std::mutex> gamma_ramp_lock(gamma_ramp_mutex_);
+          ++gamma_ramp_version_;
           reg::DC_LUT_30_COLOR& gamma_ramp_entry =
               gamma_ramp_256_entry_table_[gamma_ramp_rw_index.rw_index];
           // Bits 0:5 are hardwired to zero.
@@ -439,6 +454,8 @@ void CommandProcessor::WriteRegister(uint32_t index, uint32_t value) {
         bool write_gamma_ramp_component = (regs[XE_GPU_REG_DC_LUT_WRITE_EN_MASK] &
                                            (UINT32_C(1) << (2 - gamma_ramp_rw_component_))) != 0;
         if (write_gamma_ramp_component) {
+          std::lock_guard<std::mutex> gamma_ramp_lock(gamma_ramp_mutex_);
+          ++gamma_ramp_version_;
           reg::DC_LUT_PWL_DATA& gamma_ramp_entry =
               gamma_ramp_pwl_rgb_[gamma_ramp_rw_index_pwl][gamma_ramp_rw_component_];
           auto gamma_ramp_value = regs.Get<reg::DC_LUT_PWL_DATA>();
@@ -469,6 +486,8 @@ void CommandProcessor::WriteRegister(uint32_t index, uint32_t value) {
         auto gamma_ramp_rw_index = regs.Get<reg::DC_LUT_RW_INDEX>();
         uint32_t gamma_ramp_write_enable_mask = regs[XE_GPU_REG_DC_LUT_WRITE_EN_MASK] & 0b111;
         if (gamma_ramp_write_enable_mask) {
+          std::lock_guard<std::mutex> gamma_ramp_lock(gamma_ramp_mutex_);
+          ++gamma_ramp_version_;
           reg::DC_LUT_30_COLOR& gamma_ramp_entry =
               gamma_ramp_256_entry_table_[gamma_ramp_rw_index.rw_index];
           auto gamma_ramp_value = regs.Get<reg::DC_LUT_30_COLOR>();
diff --git a/src/graphics/graphics_system.cpp b/src/graphics/graphics_system.cpp
index fe6f426..d2ee77a 100644
--- a/src/graphics/graphics_system.cpp
+++ b/src/graphics/graphics_system.cpp
@@ -321,6 +321,14 @@ bool GraphicsSystem::SetOcclusionQueryResolver(system::OcclusionQueryResolver re
   return true;
 }
 
+bool GraphicsSystem::GetGammaRamp(system::GammaRamp& ramp) {
+  if (!command_processor_) {
+    return false;
+  }
+  command_processor_->GetGammaRamp(ramp);
+  return true;
+}
+
 void GraphicsSystem::DispatchInterruptCallback(uint32_t source, uint32_t cpu) {
   if (!interrupt_callback_) {
     return;
-- 
