diff --git a/include/rex/system/interfaces/graphics.h b/include/rex/system/interfaces/graphics.h
index d54df86..66acd16 100644
--- a/include/rex/system/interfaces/graphics.h
+++ b/include/rex/system/interfaces/graphics.h
@@ -31,6 +31,28 @@ class KernelState;
 
 namespace rex::system {
 
+// A draw packet the command processor executed, for tools that compare the guest's GPU state with
+// their own view of it (for example XenosNative's observer). Plain data, so it crosses the GPU
+// plugin boundary; the pointers are valid only during the callback.
+struct GpuDrawInfo {
+  uint32_t packet_address;  // physical address of the draw packet's type-3 header
+  uint32_t opcode;          // PM4_DRAW_INDX or PM4_DRAW_INDX_2
+  const uint32_t* registers;  // the register file after the packet (VGT_DRAW_INITIATOR included)
+  uint32_t register_count;
+  uint64_t bin_mask;    // predicated tiling: the packet ran because bin_mask & bin_select != 0
+  uint64_t bin_select;
+  bool issued;          // false if the draw was dropped (viz query kill, backend failure)
+  // The bound shaders (hash 0 if none). The constant maps are
+  // rex::graphics::Shader::ConstantRegisterMap, null until the backend analyzed the shader.
+  uint64_t vertex_shader_hash;
+  uint64_t pixel_shader_hash;
+  const void* vertex_shader_constants;
+  const void* pixel_shader_constants;
+  uint8_t vertex_shader_memexport;  // eM# written by memexport (0 = none)
+  uint8_t pixel_shader_memexport;
+};
+using GpuDrawObserver = void (*)(void* user, const GpuDrawInfo& info);
+
 class IGraphicsSystem {
  public:
   virtual ~IGraphicsSystem() = default;
@@ -71,6 +93,14 @@ class IGraphicsSystem {
     (void)block_size_log2;
   }
 
+  // Called on the GPU thread for every draw packet the command processor executes; nullptr turns it
+  // off. Off by default, and free when off. Returns false if the system has no command processor.
+  virtual bool SetDrawObserver(GpuDrawObserver observer, void* user) {
+    (void)observer;
+    (void)user;
+    return false;
+  }
+
   // Persistent shader/pipeline storage under the cache root. Default: none.
   virtual void InitializeShaderStorage(const std::filesystem::path& cache_root, uint32_t title_id,
                                        bool blocking) {
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index b201754..9d40b75 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -24,6 +24,7 @@
 #include <rex/graphics/command_processor.h>
 #include <rex/graphics/flags.h>
 #include <rex/graphics/graphics_system.h>
+#include <rex/graphics/pipeline/shader/shader.h>
 #include <rex/graphics/pipeline/texture/info.h>
 #include <rex/graphics/sampler_info.h>
 #include <rex/graphics/xenos.h>
@@ -766,6 +767,11 @@ bool CommandProcessor::ExecutePacketType3(memory::RingBuffer* reader, uint32_t p
   uint32_t opcode = (packet >> 8) & 0x7F;
   uint32_t count = ((packet >> 16) & 0x3FFF) + 1;
   auto data_start_offset = reader->read_offset();
+  if (draw_observer_.load(std::memory_order_relaxed)) [[unlikely]] {
+    size_t header_offset = (data_start_offset + reader->capacity() - sizeof(uint32_t)) % reader->capacity();
+    observed_packet_address_ =
+        uint32_t(uintptr_t(reader->buffer()) + header_offset - uintptr_t(memory_->physical_membase()));
+  }
 
   if (reader->read_count() < count * sizeof(uint32_t)) {
     REXGPU_ERROR("ExecutePacketType3 overflow (read count {:08X}, packet count {:08X})",
@@ -1359,6 +1365,7 @@ bool CommandProcessor::ExecutePacketType3Draw(memory::RingBuffer* reader, uint32
   WriteRegister(XE_GPU_REG_VGT_DRAW_INITIATOR, vgt_draw_initiator.value);
 
   bool draw_succeeded = true;
+  bool draw_issued = false;
   // TODO(Triang3l): Remove IndexBufferInfo and replace handling of all this
   // with PrimitiveProcessor when the old Vulkan renderer is removed.
   bool is_indexed = false;
@@ -1437,6 +1444,7 @@ bool CommandProcessor::ExecutePacketType3Draw(memory::RingBuffer* reader, uint32
           xenos::IsMajorModeExplicit(vgt_draw_initiator.major_mode, vgt_draw_initiator.prim_type);
       draw_succeeded = IssueDraw(vgt_draw_initiator.prim_type, vgt_draw_initiator.num_indices,
                                  is_indexed ? &index_buffer_info : nullptr, major_mode_explicit);
+      draw_issued = draw_succeeded;
       if (!draw_succeeded) {
         auto vgt_output_path_cntl = register_file_->Get<reg::VGT_OUTPUT_PATH_CNTL>();
         auto vgt_hos_cntl = register_file_->Get<reg::VGT_HOS_CNTL>();
@@ -1453,6 +1461,32 @@ bool CommandProcessor::ExecutePacketType3Draw(memory::RingBuffer* reader, uint32
     }
   }
 
+  if (system::GpuDrawObserver observer = draw_observer_.load(std::memory_order_acquire)) [[unlikely]] {
+    system::GpuDrawInfo info{};
+    info.packet_address = observed_packet_address_;
+    info.opcode = (packet >> 8) & 0x7F;
+    info.registers = register_file_->values;
+    info.register_count = uint32_t(RegisterFile::kRegisterCount);
+    info.bin_mask = bin_mask_;
+    info.bin_select = bin_select_;
+    info.issued = draw_issued;
+    if (const Shader* vs = active_vertex_shader_) {
+      info.vertex_shader_hash = vs->ucode_data_hash();
+      if (vs->is_ucode_analyzed()) {
+        info.vertex_shader_constants = &vs->constant_register_map();
+        info.vertex_shader_memexport = vs->memexport_eM_written();
+      }
+    }
+    if (const Shader* ps = active_pixel_shader_) {
+      info.pixel_shader_hash = ps->ucode_data_hash();
+      if (ps->is_ucode_analyzed()) {
+        info.pixel_shader_constants = &ps->constant_register_map();
+        info.pixel_shader_memexport = ps->memexport_eM_written();
+      }
+    }
+    observer(draw_observer_user_, info);
+  }
+
   // If read the packed correctly, but merely couldn't execute it (because of,
   // for instance, features not supported by the host), don't terminate command
   // buffer processing as that would leave rendering in a way more inconsistent
@@ -1460,6 +1494,13 @@ bool CommandProcessor::ExecutePacketType3Draw(memory::RingBuffer* reader, uint32
   return true;
 }
 
+void CommandProcessor::SetDrawObserver(system::GpuDrawObserver observer, void* user) {
+  // The user pointer is published before the observer (release), and read after it (acquire).
+  draw_observer_.store(nullptr, std::memory_order_release);
+  draw_observer_user_ = user;
+  draw_observer_.store(observer, std::memory_order_release);
+}
+
 bool CommandProcessor::ExecutePacketType3_DRAW_INDX(memory::RingBuffer* reader, uint32_t packet,
                                                     uint32_t count) {
   // "initiate fetch of index buffer and draw"
diff --git a/src/graphics/graphics_system.cpp b/src/graphics/graphics_system.cpp
index 8f2fcb0..e78478e 100644
--- a/src/graphics/graphics_system.cpp
+++ b/src/graphics/graphics_system.cpp
@@ -294,6 +294,15 @@ void GraphicsSystem::SetInterruptCallback(uint32_t callback, uint32_t user_data)
   REXGPU_INFO("SetInterruptCallback({:08X}, {:08X})", callback, user_data);
 }
 
+bool GraphicsSystem::SetDrawObserver(system::GpuDrawObserver observer, void* user) {
+  if (!command_processor_) {
+    return false;
+  }
+  command_processor_->SetDrawObserver(observer, user);
+  REXGPU_INFO("Draw observer {}", observer ? "set" : "cleared");
+  return true;
+}
+
 void GraphicsSystem::DispatchInterruptCallback(uint32_t source, uint32_t cpu) {
   if (!interrupt_callback_) {
     return;
