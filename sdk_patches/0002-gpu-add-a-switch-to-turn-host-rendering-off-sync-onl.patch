     auto viz_query = register_file_->Get<reg::PA_SC_VIZ_QUERY>();
     if (!(viz_query.viz_query_ena && viz_query.kill_pix_post_hi_z)) {
       // TODO(Triang3l): Don't drop the draw call completely if the vertex
diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index ad62c25..36d1683 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -153,7 +153,8 @@ void D3D12CommandProcessor::InitializeShaderStorage(const std::filesystem::path&
 
 bool D3D12CommandProcessor::ExecutePacketType3_EVENT_WRITE_ZPD(memory::RingBuffer* reader,
                                                                uint32_t packet, uint32_t count) {
-  if (!REXCVAR_GET(occlusion_query_enable) || !occlusion_query_resources_available_) {
+  if (!REXCVAR_GET(occlusion_query_enable) || !occlusion_query_resources_available_ ||
+      !host_rendering()) {
     return CommandProcessor::ExecutePacketType3_EVENT_WRITE_ZPD(reader, packet, count);
   }
 
diff --git a/src/graphics/graphics_system.cpp b/src/graphics/graphics_system.cpp
index e78478e..b9b47c2 100644
--- a/src/graphics/graphics_system.cpp
+++ b/src/graphics/graphics_system.cpp
@@ -303,6 +303,15 @@ bool GraphicsSystem::SetDrawObserver(system::GpuDrawObserver observer, void* use
   return true;
 }
 
+bool GraphicsSystem::SetHostRendering(bool enabled) {
+  if (!command_processor_) {
+    return false;
+  }
+  command_processor_->SetHostRendering(enabled);
+  REXGPU_INFO("Host rendering {}", enabled ? "on" : "off (sync only)");
+  return true;
+}
+
 void GraphicsSystem::DispatchInterruptCallback(uint32_t source, uint32_t cpu) {
   if (!interrupt_callback_) {
     return;
