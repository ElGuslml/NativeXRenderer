From 9647b139ffdd3a1a8a2eaf1663bd935f625c8683 Mon Sep 17 00:00:00 2001
From: Gustavo Garcia <44309076+ElGuslml@users.noreply.github.com>
Date: Wed, 14 Oct 2026 10:11:57 -0600
Subject: [PATCH 5/5] gpu: let the SPIR-V translator revert a fractional
 resolution scale

The translated shaders revert the draw resolution scale in two places: the
pixel position of parameter generation, and the texel offsets and weights
of resolution-scaled textures. The translator bakes the whole-number scale
the EDRAM emulation needs into both.

A renderer without EDRAM emulation (XenosNative) can render at any scale.
SetFractionalResolutionScale sets the scale those two places revert, as
floats of 1 or more per axis. The whole-number scale keeps its other uses
(EDRAM tiles with fragment shader interlock, memory export once per guest
pixel), which such a renderer does not use. Without the call nothing
changes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../graphics/pipeline/shader/spirv_translator.h | 17 ++++++++++++++++-
 .../pipeline/shader/spirv_translator.cpp        |  8 ++++----
 .../pipeline/shader/spirv_translator_fetch.cpp  | 14 ++++++--------
 3 files changed, 26 insertions(+), 13 deletions(-)

diff --git a/include/rex/graphics/pipeline/shader/spirv_translator.h b/include/rex/graphics/pipeline/shader/spirv_translator.h
index dce3dbf..7a20f0b 100644
--- a/include/rex/graphics/pipeline/shader/spirv_translator.h
+++ b/include/rex/graphics/pipeline/shader/spirv_translator.h
@@ -409,7 +409,19 @@ class SpirvShaderTranslator : public ShaderTranslator {
         native_2x_msaa_no_attachments_(native_2x_msaa_no_attachments),
         edram_fragment_shader_interlock_(edram_fragment_shader_interlock),
         draw_resolution_scale_x_(draw_resolution_scale_x ? draw_resolution_scale_x : 1),
-        draw_resolution_scale_y_(draw_resolution_scale_y ? draw_resolution_scale_y : 1) {}
+        draw_resolution_scale_y_(draw_resolution_scale_y ? draw_resolution_scale_y : 1),
+        shader_resolution_scale_x_(float(draw_resolution_scale_x_)),
+        shader_resolution_scale_y_(float(draw_resolution_scale_y_)) {}
+
+  // A resolution scale that need not be a whole number, for a host renderer without EDRAM emulation
+  // (XenosNative: no fragment shader interlock, no memory export at a scale). It replaces the whole
+  // scale where the translated shaders revert it: the pixel position of parameter generation and the
+  // texel offsets and weights of resolution-scaled textures. 1 or more on each axis; call before
+  // translating.
+  void SetFractionalResolutionScale(float scale_x, float scale_y) {
+    shader_resolution_scale_x_ = scale_x > 1.0f ? scale_x : 1.0f;
+    shader_resolution_scale_y_ = scale_y > 1.0f ? scale_y : 1.0f;
+  }
 
   uint64_t GetDefaultVertexShaderModification(
       uint32_t dynamic_addressable_register_count,
@@ -758,6 +770,9 @@ class SpirvShaderTranslator : public ShaderTranslator {
   bool edram_fragment_shader_interlock_;
   uint32_t draw_resolution_scale_x_;
   uint32_t draw_resolution_scale_y_;
+  // The scale the shaders revert (SetFractionalResolutionScale); the whole scale otherwise.
+  float shader_resolution_scale_x_;
+  float shader_resolution_scale_y_;
 
   // Is currently writing the empty depth-only pixel shader, such as for depth
   // and stencil testing with fragment shader interlock.
diff --git a/src/graphics/pipeline/shader/spirv_translator.cpp b/src/graphics/pipeline/shader/spirv_translator.cpp
index 1774f97..367d60b 100644
--- a/src/graphics/pipeline/shader/spirv_translator.cpp
+++ b/src/graphics/pipeline/shader/spirv_translator.cpp
@@ -3210,10 +3210,10 @@ void SpirvShaderTranslator::StartFragmentShaderInMain() {
             builder_->createAccessChain(spv::StorageClassInput, input_fragment_coordinates_,
                                         id_vector_temp_),
             spv::NoPrecision));
-    if (draw_resolution_scale_x_ > 1) {
+    if (shader_resolution_scale_x_ > 1.0f) {
       param_gen_x = builder_->createNoContractionBinOp(
           spv::OpFMul, type_float_, param_gen_x,
-          builder_->makeFloatConstant(1.0f / float(draw_resolution_scale_x_)));
+          builder_->makeFloatConstant(1.0f / shader_resolution_scale_x_));
     }
     param_gen_x = builder_->createUnaryBuiltinCall(type_float_, ext_inst_glsl_std_450_,
                                                    GLSLstd450FAbs, param_gen_x);
@@ -3246,10 +3246,10 @@ void SpirvShaderTranslator::StartFragmentShaderInMain() {
             builder_->createAccessChain(spv::StorageClassInput, input_fragment_coordinates_,
                                         id_vector_temp_),
             spv::NoPrecision));
-    if (draw_resolution_scale_y_ > 1) {
+    if (shader_resolution_scale_y_ > 1.0f) {
       param_gen_y = builder_->createNoContractionBinOp(
           spv::OpFMul, type_float_, param_gen_y,
-          builder_->makeFloatConstant(1.0f / float(draw_resolution_scale_y_)));
+          builder_->makeFloatConstant(1.0f / shader_resolution_scale_y_));
     }
     param_gen_y = builder_->createUnaryBuiltinCall(type_float_, ext_inst_glsl_std_450_,
                                                    GLSLstd450FAbs, param_gen_y);
diff --git a/src/graphics/pipeline/shader/spirv_translator_fetch.cpp b/src/graphics/pipeline/shader/spirv_translator_fetch.cpp
index 9ce3bb4..5b1fe61 100644
--- a/src/graphics/pipeline/shader/spirv_translator_fetch.cpp
+++ b/src/graphics/pipeline/shader/spirv_translator_fetch.cpp
@@ -974,8 +974,8 @@ void SpirvShaderTranslator::ProcessTextureFetchInstruction(
       coordinates[coordinate_component_index] = coordinates_operand;
     }
     spv::Id texture_resolution_scaled = spv::NoResult;
-    uint32_t revert_resolution_scale_axes =
-        uint32_t(draw_resolution_scale_x_ > 1) | (uint32_t(draw_resolution_scale_y_ > 1) << 1);
+    uint32_t revert_resolution_scale_axes = uint32_t(shader_resolution_scale_x_ > 1.0f) |
+                                            (uint32_t(shader_resolution_scale_y_ > 1.0f) << 1);
     spv::Id const_texture_resolution_scale[] = {spv::NoResult, spv::NoResult};
     spv::Id const_texture_resolution_scale_reciprocal[] = {spv::NoResult, spv::NoResult};
     if (revert_resolution_scale_axes) {
@@ -991,16 +991,14 @@ void SpirvShaderTranslator::ProcessTextureFetchInstruction(
                                 builder_->makeUintConstant(UINT32_C(1) << fetch_constant_index)),
           const_uint_0_);
       if (revert_resolution_scale_axes & 0b001) {
-        const_texture_resolution_scale[0] =
-            builder_->makeFloatConstant(float(draw_resolution_scale_x_));
+        const_texture_resolution_scale[0] = builder_->makeFloatConstant(shader_resolution_scale_x_);
         const_texture_resolution_scale_reciprocal[0] =
-            builder_->makeFloatConstant(1.0f / float(draw_resolution_scale_x_));
+            builder_->makeFloatConstant(1.0f / shader_resolution_scale_x_);
       }
       if (revert_resolution_scale_axes & 0b010) {
-        const_texture_resolution_scale[1] =
-            builder_->makeFloatConstant(float(draw_resolution_scale_y_));
+        const_texture_resolution_scale[1] = builder_->makeFloatConstant(shader_resolution_scale_y_);
         const_texture_resolution_scale_reciprocal[1] =
-            builder_->makeFloatConstant(1.0f / float(draw_resolution_scale_y_));
+            builder_->makeFloatConstant(1.0f / shader_resolution_scale_y_);
       }
     }
 
