From 6d7ed84c0da2017639e599e2fbe68b4fff7fc1f9 Mon Sep 17 00:00:00 2001
From: Gustavo Garcia <44309076+ElGuslml@users.noreply.github.com>
Date: Wed, 14 Oct 2026 03:47:59 -0600
Subject: [PATCH 3/5] gpu: let a sync-only consumer answer occlusion queries

With host rendering off (SetHostRendering, a renderer such as XenosNative
draws the guest's frames itself), the command processor answers every
occlusion query end with the fake sample count, so effects driven by
queries (a sun flare's visibility) run at full strength behind walls.

SetOcclusionQueryResolver registers a callback that the generic
EVENT_WRITE_ZPD path calls on the GPU thread when a query ends (the
event after D3D's 0xFFFFFEED end marker), with the physical address of
the query's sample counts. If it answers, the samples are written as the
host query path writes them: ZPass_A and ZPass_B last, with one store,
since D3D adds both as soon as either loses the marker. Otherwise the
fake sample count is written as before. Begin events are unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/rex/graphics/command_processor.h |  8 +++++++
 include/rex/graphics/graphics_system.h   |  1 +
 include/rex/system/interfaces/graphics.h | 22 ++++++++++++++++---
 src/graphics/command_processor.cpp       | 27 +++++++++++++++++++++++-
 src/graphics/graphics_system.cpp         |  9 ++++++++
 5 files changed, 63 insertions(+), 4 deletions(-)

diff --git a/include/rex/graphics/command_processor.h b/include/rex/graphics/command_processor.h
index 7a1ee19..e8e1325 100644
--- a/include/rex/graphics/command_processor.h
+++ b/include/rex/graphics/command_processor.h
@@ -96,6 +96,11 @@ class CommandProcessor {
 
   // See system::IGraphicsSystem::SetHostRendering.
   void SetHostRendering(bool enabled) { host_rendering_.store(enabled, std::memory_order_relaxed); }
+  // See system::IGraphicsSystem::SetOcclusionQueryResolver.
+  void SetOcclusionQueryResolver(system::OcclusionQueryResolver resolver, void* user) {
+    occlusion_query_resolver_user_ = user;
+    occlusion_query_resolver_.store(resolver, std::memory_order_release);
+  }
   bool host_rendering() const { return host_rendering_.load(std::memory_order_relaxed); }
 
   virtual bool Initialize();
@@ -279,6 +284,9 @@ class CommandProcessor {
   std::atomic<system::GpuDrawObserver> draw_observer_{nullptr};
   // Off: packets run for synchronization only (SetHostRendering).
   std::atomic<bool> host_rendering_{true};
+  // Answers occlusion queries the command processor has no host query for (SetOcclusionQueryResolver).
+  std::atomic<system::OcclusionQueryResolver> occlusion_query_resolver_{nullptr};
+  void* occlusion_query_resolver_user_ = nullptr;
   void* draw_observer_user_ = nullptr;
   uint32_t observed_packet_address_ = 0;
 
diff --git a/include/rex/graphics/graphics_system.h b/include/rex/graphics/graphics_system.h
index ae5ec2c..3b11d42 100644
--- a/include/rex/graphics/graphics_system.h
+++ b/include/rex/graphics/graphics_system.h
@@ -77,6 +77,7 @@ class GraphicsSystem : public system::IGraphicsSystem {
   void SetInterruptCallback(uint32_t callback, uint32_t user_data) override;
   bool SetDrawObserver(system::GpuDrawObserver observer, void* user) override;
   bool SetHostRendering(bool enabled) override;
+  bool SetOcclusionQueryResolver(system::OcclusionQueryResolver resolver, void* user) override;
   void DispatchInterruptCallback(uint32_t source, uint32_t cpu);
 
   virtual void ClearCaches();
diff --git a/include/rex/system/interfaces/graphics.h b/include/rex/system/interfaces/graphics.h
index 7338633..f9a698a 100644
--- a/include/rex/system/interfaces/graphics.h
+++ b/include/rex/system/interfaces/graphics.h
@@ -53,6 +53,11 @@ struct GpuDrawInfo {
 };
 using GpuDrawObserver = void (*)(void* user, const GpuDrawInfo& info);
 
+// Answers a guest occlusion query that ended (see IGraphicsSystem::SetOcclusionQueryResolver):
+// sample_count_address is the physical address of the query's sample counts. Returns true with the
+// number of samples that passed, at the guest's resolution, or false for the fake sample count.
+using OcclusionQueryResolver = bool (*)(void* user, uint32_t sample_count_address, uint64_t* samples);
+
 class IGraphicsSystem {
  public:
   virtual ~IGraphicsSystem() = default;
@@ -103,14 +108,25 @@ class IGraphicsSystem {
 
   // Host rendering on or off. Off, the command processor still executes every packet (registers,
   // fences, interrupts, swaps, event writes) but draws nothing on the host: draws, clears and resolves
-  // are skipped, and occlusion queries report the fake sample count. For a renderer that draws the
-  // guest's frames itself from another source (XenosNative). On by default; may be changed at any
-  // time. Returns false if the system has no command processor.
+  // are skipped, and occlusion queries report the fake sample count, or what the occlusion query
+  // resolver answers. For a renderer that draws the guest's frames itself from another source
+  // (XenosNative). On by default; may be changed at any time. Returns false if the system has no
+  // command processor.
   virtual bool SetHostRendering(bool enabled) {
     (void)enabled;
     return false;
   }
 
+  // Called on the GPU thread when a guest occlusion query ends and the command processor has no host
+  // query for it (host rendering off, or host queries disabled), to answer it in place of the fake
+  // sample count. For a renderer that draws the guest's frames itself and measures the queries.
+  // nullptr turns it off. Returns false if the system has no command processor.
+  virtual bool SetOcclusionQueryResolver(OcclusionQueryResolver resolver, void* user) {
+    (void)resolver;
+    (void)user;
+    return false;
+  }
+
   // Persistent shader/pipeline storage under the cache root. Default: none.
   virtual void InitializeShaderStorage(const std::filesystem::path& cache_root, uint32_t title_id,
                                        bool blocking) {
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index 3daf673..a739f53 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -1320,7 +1320,32 @@ bool CommandProcessor::ExecutePacketType3_EVENT_WRITE_ZPD(memory::RingBuffer* re
 
   // Occlusion queries:
   // This command is send on query begin and end.
-  // As a workaround report some fixed amount of passed samples.
+  // A resolver (SetOcclusionQueryResolver) answers the ends, for a renderer that measured the query
+  // itself.
+  if (auto resolver = occlusion_query_resolver_.load(std::memory_order_acquire)) {
+    uint32_t sample_count_address = register_file_->values[XE_GPU_REG_RB_SAMPLE_COUNT_ADDR];
+    auto* sample_counts = memory_->TranslatePhysical<xe_gpu_depth_sample_counts*>(sample_count_address);
+    uint64_t samples = 0;
+    if (sample_counts &&
+        (sample_counts->ZPass_A == kQueryFinished || sample_counts->ZPass_B == kQueryFinished ||
+         sample_counts->ZFail_A == kQueryFinished || sample_counts->ZFail_B == kQueryFinished) &&
+        resolver(occlusion_query_resolver_user_, sample_count_address, &samples)) {
+      uint32_t clamped = samples > uint64_t(UINT32_MAX) ? UINT32_MAX : uint32_t(samples);
+      sample_counts->Total_A = clamped;
+      sample_counts->Total_B = 0;
+      sample_counts->ZFail_A = 0;
+      sample_counts->ZFail_B = 0;
+      sample_counts->StencilFail_A = 0;
+      sample_counts->StencilFail_B = 0;
+      // D3D takes the query as finished as soon as ZPass_A or ZPass_B no longer holds the end marker,
+      // and then adds both: write the pair last, with one store (ZPass_A = the samples, ZPass_B = 0).
+      uint64_t zpass = clamped;
+      std::atomic_thread_fence(std::memory_order_release);
+      std::memcpy(static_cast<void*>(&sample_counts->ZPass_A), &zpass, sizeof(zpass));
+      return true;
+    }
+  }
+  // Otherwise, as a workaround, report some fixed amount of passed samples.
   auto fake_sample_count = REXCVAR_GET(query_occlusion_fake_sample_count);
   if (fake_sample_count >= 0) {
     auto* pSampleCounts = memory_->TranslatePhysical<xe_gpu_depth_sample_counts*>(
diff --git a/src/graphics/graphics_system.cpp b/src/graphics/graphics_system.cpp
index b9b47c2..fe6f426 100644
--- a/src/graphics/graphics_system.cpp
+++ b/src/graphics/graphics_system.cpp
@@ -312,6 +312,15 @@ bool GraphicsSystem::SetHostRendering(bool enabled) {
   return true;
 }
 
+bool GraphicsSystem::SetOcclusionQueryResolver(system::OcclusionQueryResolver resolver, void* user) {
+  if (!command_processor_) {
+    return false;
+  }
+  command_processor_->SetOcclusionQueryResolver(resolver, user);
+  REXGPU_INFO("Occlusion query resolver {}", resolver ? "set" : "removed");
+  return true;
+}
+
 void GraphicsSystem::DispatchInterruptCallback(uint32_t source, uint32_t cpu) {
   if (!interrupt_callback_) {
     return;
