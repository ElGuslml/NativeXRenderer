@@ -1109,12 +1112,287 @@ void PipelineStateVkImpl::InitializePipeline(const GraphicsPipelineStateCreateIn
     std::vector<VulkanUtilities::ShaderModuleWrapper> ShaderModules;
     std::vector<ShaderStageSpecializationData>        SpecDataPerStage;
 
-    InitInternalObjects(CreateInfo, vkShaderStages, ShaderModules, SpecDataPerStage);
+    const TShaderStages ShaderStages = InitInternalObjects(CreateInfo, vkShaderStages, ShaderModules, SpecDataPerStage);
 
     const VkPipelineCache vkSPOCache = CreateInfo.pPSOCache != nullptr ? ClassPtrCast<PipelineStateCacheVkImpl>(CreateInfo.pPSOCache)->GetVkPipelineCache() : VK_NULL_HANDLE;
+
+    // NativeXRenderer's patch: the pipeline linked from the device's parts, ready now, and the whole pipeline compiled
+    // behind every other task; its stages, modules and specialization data are kept alive by the task.
+    IThreadPool* pThreadPool = m_pDevice->GetShaderCompilationThreadPool();
+    if ((CreateInfo.Flags & PSO_CREATE_FLAG_VK_LINK_FROM_LIBRARIES) != 0 && pThreadPool != nullptr &&
+        GetRenderPassPtr() == nullptr && m_pDevice->GetImplicitRenderPassCache() == nullptr &&
+        LinkGraphicsPipeline(vkShaderStages, ShaderStages, vkSPOCache))
+    {
+        struct WholePipelineData
+        {
+            std::vector<VkPipelineShaderStageCreateInfo>      Stages;
+            std::vector<VulkanUtilities::ShaderModuleWrapper> Modules;
+            std::vector<ShaderStageSpecializationData>        SpecData;
+            std::vector<std::string>                          EntryPoints;
+            RefCntAutoPtr<IPipelineStateCache>                pCache;
+            VkPipelineCache                                   vkCache = VK_NULL_HANDLE;
+        };
+        auto pData      = std::make_shared<WholePipelineData>();
+        pData->Stages   = std::move(vkShaderStages);
+        pData->Modules  = std::move(ShaderModules);
+        pData->SpecData = std::move(SpecDataPerStage);
+        pData->EntryPoints.reserve(pData->Stages.size());
+        for (VkPipelineShaderStageCreateInfo& Stage : pData->Stages)
+        {
+            pData->EntryPoints.emplace_back(Stage.pName != nullptr ? Stage.pName : "main");
+            Stage.pName = pData->EntryPoints.back().c_str();
+        }
+        pData->pCache  = CreateInfo.pPSOCache;
+        pData->vkCache = vkSPOCache;
+        m_WholeTask    = EnqueueAsyncWork(
+            pThreadPool,
+            [this, pData](Uint32 ThreadId) {
+                try
+                {
+                    VulkanUtilities::PipelineWrapper Whole;
+                    RefCntAutoPtr<IRenderPass>       pNoRenderPass;
+                    CreateGraphicsPipeline(m_pDevice, pData->Stages, m_PipelineLayout, m_Desc, m_pGraphicsPipelineData->Desc, Whole, pNoRenderPass, pData->vkCache);
+                    m_WholePipeline = std::move(Whole);
+                    m_WholeReady.store(true, std::memory_order_release);
+                }
+                catch (...)
+                {
+                }
+                return ASYNC_TASK_STATUS_COMPLETE;
+            },
+            -1.f);
+        return;
+    }
+    if ((CreateInfo.Flags & PSO_CREATE_FLAG_VK_LINK_FROM_LIBRARIES) != 0)
+        m_pDevice->CountPipelineLibraryStat(4);
     CreateGraphicsPipeline(m_pDevice, vkShaderStages, m_PipelineLayout, m_Desc, m_pGraphicsPipelineData->Desc, m_Pipeline, GetRenderPassPtr(), vkSPOCache);
 }
 
+bool PipelineStateVkImpl::LinkGraphicsPipeline(const std::vector<VkPipelineShaderStageCreateInfo>& vkShaderStages,
+                                               const TShaderStages&                                ShaderStages,
+                                               VkPipelineCache                                     vkPSOCache)
+{
+    const GraphicsPipelineDesc&           GraphicsPipeline = m_pGraphicsPipelineData->Desc;
+    const VulkanUtilities::LogicalDevice& LogicalDevice    = m_pDevice->GetLogicalDevice();
+    if (m_Desc.PipelineType != PIPELINE_TYPE_GRAPHICS || GraphicsPipeline.InputLayout.NumElements != 0 ||
+        !GraphicsPipeline.RasterizerDesc.ScissorEnable || GraphicsPipeline.ShadingRateFlags != PIPELINE_SHADING_RATE_FLAG_NONE)
+        return false;
+
+    // The vertex and pixel shaders' stages and their SPIR-V (the parts' keys): no other stage.
+    const VkPipelineShaderStageCreateInfo* pVertexStage = nullptr;
+    const VkPipelineShaderStageCreateInfo* pPixelStage  = nullptr;
+    const std::vector<uint32_t>*           pVertexSPIRV = nullptr;
+    const std::vector<uint32_t>*           pPixelSPIRV  = nullptr;
+    size_t                                 StageIndex   = 0;
+    for (const ShaderStageInfo& Stage : ShaderStages)
+    {
+        if (Stage.Items.size() != 1 || StageIndex >= vkShaderStages.size())
+            return false;
+        if (Stage.Type == SHADER_TYPE_VERTEX)
+        {
+            pVertexStage = &vkShaderStages[StageIndex];
+            pVertexSPIRV = &Stage.Items[0].SPIRV;
+        }
+        else if (Stage.Type == SHADER_TYPE_PIXEL)
+        {
+            pPixelStage = &vkShaderStages[StageIndex];
+            pPixelSPIRV = &Stage.Items[0].SPIRV;
+        }
+        else
+        {
+            return false;
+        }
+        ++StageIndex;
+    }
+    if (pVertexStage == nullptr)
+        return false;
+
+    auto Append = [](std::string& Key, const void* pData, size_t Size) {
+        Key.append(static_cast<const char*>(pData), Size);
+    };
+    // The parts with shaders are made with this pipeline's layout; another pipeline's identically defined layout (the
+    // same resource signatures) links them too.
+    std::string LayoutKey;
+    for (Uint32 i = 0; i < m_SignatureCount; ++i)
+    {
+        const void* pSignature = m_Signatures[i].RawPtr();
+        Append(LayoutKey, &pSignature, sizeof(pSignature));
+    }
+
+    std::vector<VkFormat>            ColorFormats;
+    VkPipelineRenderingCreateInfoKHR RenderingCI = GraphicsPipelineDesc_To_VkPipelineRenderingCreateInfo(GraphicsPipeline, ColorFormats);
+
+    VkPipelineVertexInputStateCreateInfo VertexInputCI{};
+    VertexInputCI.sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO;
+
+    VkPipelineInputAssemblyStateCreateInfo InputAssemblyCI{};
+    InputAssemblyCI.sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO;
+    InputAssemblyCI.primitiveRestartEnable =
+        (GraphicsPipeline.PrimitiveTopology == PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP ||
+         GraphicsPipeline.PrimitiveTopology == PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP_ADJ ||
+         GraphicsPipeline.PrimitiveTopology == PRIMITIVE_TOPOLOGY_LINE_STRIP ||
+         GraphicsPipeline.PrimitiveTopology == PRIMITIVE_TOPOLOGY_LINE_STRIP_ADJ) ?
+        VK_TRUE :
+        VK_FALSE;
+    uint32_t PatchControlPoints = 0;
+    PrimitiveTopology_To_VkPrimitiveTopologyAndPatchCPCount(GraphicsPipeline.PrimitiveTopology, InputAssemblyCI.topology, PatchControlPoints);
+    if (PatchControlPoints != 0)
+        return false;
+
+    VkPipelineViewportStateCreateInfo ViewportCI{};
+    ViewportCI.sType         = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO;
+    ViewportCI.viewportCount = GraphicsPipeline.NumViewports;
+    ViewportCI.scissorCount  = GraphicsPipeline.NumViewports;
+
+    const VkPipelineRasterizationStateCreateInfo RasterizationCI = RasterizerStateDesc_To_VkRasterizationStateCI(GraphicsPipeline.RasterizerDesc);
+    const VkPipelineDepthStencilStateCreateInfo  DepthStencilCI  = DepthStencilStateDesc_To_VkDepthStencilStateCI(GraphicsPipeline.DepthStencilDesc);
+
+    VkPipelineMultisampleStateCreateInfo MultisampleCI{};
+    MultisampleCI.sType                 = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO;
+    MultisampleCI.rasterizationSamples  = static_cast<VkSampleCountFlagBits>(GraphicsPipeline.SmplDesc.Count);
+    uint32_t SampleMask[]               = {GraphicsPipeline.SampleMask, 0};
+    MultisampleCI.pSampleMask           = SampleMask;
+    MultisampleCI.alphaToCoverageEnable = VK_FALSE;
+
+    std::vector<VkPipelineColorBlendAttachmentState> BlendAttachments(RenderingCI.colorAttachmentCount);
+    VkPipelineColorBlendStateCreateInfo              BlendCI{};
+    BlendCI.pAttachments    = !BlendAttachments.empty() ? BlendAttachments.data() : nullptr;
+    BlendCI.attachmentCount = RenderingCI.colorAttachmentCount;
+    BlendStateDesc_To_VkBlendStateCI(GraphicsPipeline.BlendDesc, BlendCI, BlendAttachments);
+
+    auto MakePart = [&](VkGraphicsPipelineLibraryFlagsEXT LibraryFlags, VkGraphicsPipelineCreateInfo PartCI, const VkDynamicState* pDynamicStates, Uint32 DynamicStateCount) {
+        VkGraphicsPipelineLibraryCreateInfoEXT LibraryCI{};
+        LibraryCI.sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_LIBRARY_CREATE_INFO_EXT;
+        LibraryCI.pNext = &RenderingCI;
+        LibraryCI.flags = LibraryFlags;
+        VkPipelineDynamicStateCreateInfo DynamicCI{};
+        DynamicCI.sType             = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO;
+        DynamicCI.dynamicStateCount = DynamicStateCount;
+        DynamicCI.pDynamicStates    = pDynamicStates;
+        PartCI.sType                = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO;
+        PartCI.pNext                = &LibraryCI;
+        PartCI.flags                = VK_PIPELINE_CREATE_LIBRARY_BIT_KHR;
+        PartCI.pDynamicState        = DynamicStateCount != 0 ? &DynamicCI : nullptr;
+        PartCI.basePipelineIndex    = -1;
+        return LogicalDevice.CreateGraphicsPipeline(PartCI, vkPSOCache, m_Desc.Name);
+    };
+
+    VkPipeline Parts[4] = {};
+
+    // Vertex input: the topology (no vertex buffers: the vertices are fetched in the shaders).
+    {
+        std::string Key;
+        Append(Key, &InputAssemblyCI.topology, sizeof(InputAssemblyCI.topology));
+        Append(Key, &InputAssemblyCI.primitiveRestartEnable, sizeof(InputAssemblyCI.primitiveRestartEnable));
+        Parts[0] = m_pDevice->GetPipelineLibrary(0, Key, [&]() {
+            VkGraphicsPipelineCreateInfo CI{};
+            CI.pVertexInputState   = &VertexInputCI;
+            CI.pInputAssemblyState = &InputAssemblyCI;
+            return MakePart(VK_GRAPHICS_PIPELINE_LIBRARY_VERTEX_INPUT_INTERFACE_BIT_EXT, CI, nullptr, 0);
+        });
