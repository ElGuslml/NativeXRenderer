+        std::string Key = LayoutKey;
+        Append(Key, &RasterizationCI.polygonMode, sizeof(RasterizationCI.polygonMode));
+        Append(Key, &RasterizationCI.depthClampEnable, sizeof(RasterizationCI.depthClampEnable));
+        Append(Key, &RasterizationCI.rasterizerDiscardEnable, sizeof(RasterizationCI.rasterizerDiscardEnable));
+        Append(Key, &RasterizationCI.lineWidth, sizeof(RasterizationCI.lineWidth));
+        Append(Key, &ViewportCI.viewportCount, sizeof(ViewportCI.viewportCount));
+        Append(Key, pVertexSPIRV->data(), pVertexSPIRV->size() * sizeof(uint32_t));
+        Parts[1] = m_pDevice->GetPipelineLibrary(1, Key, [&]() {
+            static constexpr VkDynamicState kDynamic[] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR,
+                                                          VK_DYNAMIC_STATE_CULL_MODE, VK_DYNAMIC_STATE_FRONT_FACE,
+                                                          VK_DYNAMIC_STATE_DEPTH_BIAS_ENABLE, VK_DYNAMIC_STATE_DEPTH_BIAS};
+            VkGraphicsPipelineCreateInfo CI{};
+            CI.stageCount          = 1;
+            CI.pStages             = pVertexStage;
+            CI.layout              = m_PipelineLayout.GetVkPipelineLayout();
+            CI.pViewportState      = &ViewportCI;
+            CI.pRasterizationState = &RasterizationCI;
+            return MakePart(VK_GRAPHICS_PIPELINE_LIBRARY_PRE_RASTERIZATION_SHADERS_BIT_EXT, CI, kDynamic, static_cast<Uint32>(std::size(kDynamic)));
+        });
+    }
+    // Fragment shader: the pixel shader (none for depth only), with its depth and stencil state dynamic.
+    {
+        std::string Key = LayoutKey;
+        if (pPixelSPIRV != nullptr)
+            Append(Key, pPixelSPIRV->data(), pPixelSPIRV->size() * sizeof(uint32_t));
+        Parts[2] = m_pDevice->GetPipelineLibrary(2, Key, [&]() {
+            static constexpr VkDynamicState kDynamic[] = {VK_DYNAMIC_STATE_STENCIL_REFERENCE, VK_DYNAMIC_STATE_STENCIL_COMPARE_MASK,
+                                                          VK_DYNAMIC_STATE_STENCIL_WRITE_MASK, VK_DYNAMIC_STATE_DEPTH_TEST_ENABLE,
+                                                          VK_DYNAMIC_STATE_DEPTH_WRITE_ENABLE, VK_DYNAMIC_STATE_DEPTH_COMPARE_OP,
+                                                          VK_DYNAMIC_STATE_STENCIL_TEST_ENABLE, VK_DYNAMIC_STATE_STENCIL_OP};
+            VkGraphicsPipelineCreateInfo CI{};
+            CI.stageCount         = pPixelStage != nullptr ? 1 : 0;
+            CI.pStages            = pPixelStage;
+            CI.layout             = m_PipelineLayout.GetVkPipelineLayout();
+            CI.pDepthStencilState = &DepthStencilCI;
+            return MakePart(VK_GRAPHICS_PIPELINE_LIBRARY_FRAGMENT_SHADER_BIT_EXT, CI, kDynamic, static_cast<Uint32>(std::size(kDynamic)));
+        });
+    }
+    // Fragment output: the targets' formats, the samples and the blending.
+    {
+        std::string Key;
+        Append(Key, &RenderingCI.colorAttachmentCount, sizeof(RenderingCI.colorAttachmentCount));
+        Append(Key, ColorFormats.data(), ColorFormats.size() * sizeof(VkFormat));
+        Append(Key, &RenderingCI.depthAttachmentFormat, sizeof(RenderingCI.depthAttachmentFormat));
+        Append(Key, &RenderingCI.stencilAttachmentFormat, sizeof(RenderingCI.stencilAttachmentFormat));
+        Append(Key, &MultisampleCI.rasterizationSamples, sizeof(MultisampleCI.rasterizationSamples));
+        Append(Key, SampleMask, sizeof(SampleMask));
+        Append(Key, &BlendCI.logicOpEnable, sizeof(BlendCI.logicOpEnable));
+        Append(Key, &BlendCI.logicOp, sizeof(BlendCI.logicOp));
+        Append(Key, BlendAttachments.data(), BlendAttachments.size() * sizeof(VkPipelineColorBlendAttachmentState));
+        Parts[3] = m_pDevice->GetPipelineLibrary(3, Key, [&]() {
+            static constexpr VkDynamicState kDynamic[] = {VK_DYNAMIC_STATE_BLEND_CONSTANTS};
+            VkGraphicsPipelineCreateInfo CI{};
+            CI.pColorBlendState  = &BlendCI;
+            CI.pMultisampleState = &MultisampleCI;
+            return MakePart(VK_GRAPHICS_PIPELINE_LIBRARY_FRAGMENT_OUTPUT_INTERFACE_BIT_EXT, CI, kDynamic, static_cast<Uint32>(std::size(kDynamic)));
+        });
+    }
+    for (VkPipeline Part : Parts)
+    {
+        if (Part == VK_NULL_HANDLE)
+            return false;
+    }
+
+    VkPipelineLibraryCreateInfoKHR LinkCI{};
+    LinkCI.sType        = VK_STRUCTURE_TYPE_PIPELINE_LIBRARY_CREATE_INFO_KHR;
+    LinkCI.libraryCount = static_cast<uint32_t>(std::size(Parts));
+    LinkCI.pLibraries   = Parts;
+    VkGraphicsPipelineCreateInfo PipelineCI{};
+    PipelineCI.sType             = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO;
+    PipelineCI.pNext             = &LinkCI;
+    PipelineCI.layout            = m_PipelineLayout.GetVkPipelineLayout();
+    PipelineCI.basePipelineIndex = -1;
+    try
+    {
+        m_Pipeline = LogicalDevice.CreateGraphicsPipeline(PipelineCI, vkPSOCache, m_Desc.Name);
+    }
+    catch (...)
+    {
+        return false;
+    }
+    if (!m_Pipeline)
+        return false;
+    m_LinkedFromLibraries = true;
+    m_LinkedRasterization = RasterizationCI;
+    m_LinkedDepthStencil  = DepthStencilCI;
+    m_pDevice->CountPipelineLibraryStat(2);
+    return true;
+}
