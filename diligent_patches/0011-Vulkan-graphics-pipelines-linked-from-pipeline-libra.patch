diff --git a/Graphics/GraphicsEngine/interface/PipelineState.h b/Graphics/GraphicsEngine/interface/PipelineState.h
index 8ed8c55f6..ceb3a995a 100644
--- a/Graphics/GraphicsEngine/interface/PipelineState.h
+++ b/Graphics/GraphicsEngine/interface/PipelineState.h
@@ -700,7 +700,16 @@ DILIGENT_TYPED_ENUM(PSO_CREATE_FLAGS, Uint32)
     /// the flag is ignored and the pipeline is created synchronously.
     PSO_CREATE_FLAG_ASYNCHRONOUS                      = 1u << 3u,
 
-    PSO_CREATE_FLAG_LAST = PSO_CREATE_FLAG_ASYNCHRONOUS
+    /// Vulkan (NativeXRenderer's patch): link the graphics pipeline from VK_EXT_graphics_pipeline_library parts the
+    /// device keeps (vertex input, pre-rasterization shaders, fragment shader, fragment output), with its cull mode,
+    /// front face, depth bias and depth-stencil state dynamic, and compile the whole pipeline behind it at a low
+    /// priority: it replaces the linked one the next time the pipeline is set. The application enables
+    /// VK_KHR_pipeline_library and VK_EXT_graphics_pipeline_library (EngineVkCreateInfo::ppDeviceExtensionNames and
+    /// pDeviceExtensionFeatures), draws with dynamic rendering and creates the pipeline asynchronously; otherwise, or if a
+    /// part cannot be made, the pipeline is made whole as without the flag.
+    PSO_CREATE_FLAG_VK_LINK_FROM_LIBRARIES            = 1u << 4u,
+
+    PSO_CREATE_FLAG_LAST = PSO_CREATE_FLAG_VK_LINK_FROM_LIBRARIES
 };
 DEFINE_FLAG_ENUM_OPERATORS(PSO_CREATE_FLAGS);
 
