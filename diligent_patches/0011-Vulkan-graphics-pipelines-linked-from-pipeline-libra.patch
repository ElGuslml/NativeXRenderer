+VkPipeline RenderDeviceVkImpl::GetPipelineLibrary(Uint32 Kind, const std::string& Key, const std::function<VulkanUtilities::PipelineWrapper()>& Create)
+{
+    VERIFY_EXPR(Kind < 4);
+    PipelineLibraryPart* pPart = nullptr;
+    {
+        std::lock_guard<std::mutex> Lock{m_PipelineLibraryMtx[Kind]};
+        std::unique_ptr<PipelineLibraryPart>& pSlot = m_PipelineLibraries[Kind][Key];
+        if (!pSlot)
+            pSlot = std::make_unique<PipelineLibraryPart>();
+        pPart = pSlot.get();
+    }
+    std::lock_guard<std::mutex> Lock{pPart->Mtx};
+    if (!pPart->Tried)
+    {
+        pPart->Tried = true;
+        try
+        {
+            pPart->Library = Create();
+        }
+        catch (...)
+        {
+        }
+        if (pPart->Library)
+            ++m_PipelineLibraryStats[0];
+    }
+    else if (pPart->Library)
+    {
+        ++m_PipelineLibraryStats[1];
+    }
+    return pPart->Library;
+}
