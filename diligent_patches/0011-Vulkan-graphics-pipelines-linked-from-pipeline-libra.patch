diff --git a/Graphics/GraphicsEngineVulkan/include/VulkanUtilities/CommandBuffer.hpp b/Graphics/GraphicsEngineVulkan/include/VulkanUtilities/CommandBuffer.hpp
index bb34e8d2a..1b8b23dba 100644
--- a/Graphics/GraphicsEngineVulkan/include/VulkanUtilities/CommandBuffer.hpp
+++ b/Graphics/GraphicsEngineVulkan/include/VulkanUtilities/CommandBuffer.hpp
@@ -422,6 +422,28 @@ public:
         }
     }
 
+    // NativeXRenderer's patch: the states of a pipeline linked from libraries that are dynamic in it
+    // (PSO_CREATE_FLAG_VK_LINK_FROM_LIBRARIES), after it is bound.
+    __forceinline void SetLinkedPipelineDynamicState(const VkPipelineRasterizationStateCreateInfo& R,
+                                                     const VkPipelineDepthStencilStateCreateInfo&  D)
+    {
+        VERIFY_EXPR(m_VkCmdBuffer != VK_NULL_HANDLE);
+        vkCmdSetCullMode(m_VkCmdBuffer, R.cullMode);
+        vkCmdSetFrontFace(m_VkCmdBuffer, R.frontFace);
+        vkCmdSetDepthBiasEnable(m_VkCmdBuffer, R.depthBiasEnable);
+        vkCmdSetDepthBias(m_VkCmdBuffer, R.depthBiasConstantFactor, R.depthBiasClamp, R.depthBiasSlopeFactor);
+        vkCmdSetDepthTestEnable(m_VkCmdBuffer, D.depthTestEnable);
+        vkCmdSetDepthWriteEnable(m_VkCmdBuffer, D.depthWriteEnable);
+        vkCmdSetDepthCompareOp(m_VkCmdBuffer, D.depthCompareOp);
+        vkCmdSetStencilTestEnable(m_VkCmdBuffer, D.stencilTestEnable);
+        vkCmdSetStencilOp(m_VkCmdBuffer, VK_STENCIL_FACE_FRONT_BIT, D.front.failOp, D.front.passOp, D.front.depthFailOp, D.front.compareOp);
+        vkCmdSetStencilOp(m_VkCmdBuffer, VK_STENCIL_FACE_BACK_BIT, D.back.failOp, D.back.passOp, D.back.depthFailOp, D.back.compareOp);
+        vkCmdSetStencilCompareMask(m_VkCmdBuffer, VK_STENCIL_FACE_FRONT_BIT, D.front.compareMask);
+        vkCmdSetStencilCompareMask(m_VkCmdBuffer, VK_STENCIL_FACE_BACK_BIT, D.back.compareMask);
+        vkCmdSetStencilWriteMask(m_VkCmdBuffer, VK_STENCIL_FACE_FRONT_BIT, D.front.writeMask);
+        vkCmdSetStencilWriteMask(m_VkCmdBuffer, VK_STENCIL_FACE_BACK_BIT, D.back.writeMask);
+    }
+
     __forceinline void BindGraphicsPipeline(VkPipeline GraphicsPipeline)
     {
         // 9.8
